#!/usr/bin/env bash
#
# run — take real backups to a real bucket, several machines at once.
#
#     scripts/backup-e2e/run                  # every shape, in parallel
#     scripts/backup-e2e/run --shapes 2       # fewer
#     scripts/backup-e2e/run --rotation       # and one machine moved to a new bucket
#     scripts/backup-e2e/run --rotation-only  # just that
#     scripts/backup-e2e/run --corpus-mb 256  # enough data for the cost figures
#     scripts/backup-e2e/run --full-read      # and what re-reading everything costs
#     scripts/backup-e2e/run --keep           # leave the repositories behind
#     scripts/backup-e2e/run --reap-only      # just delete old test repositories
#
# WHAT THIS TESTS THAT NOTHING ELSE DOES
#
# Everything from the credentials round trip to the bytes in the bucket. The
# self-update harness proves a machine comes back after an upgrade; this proves
# it still backs up, which is what the program is for. Between them they cover
# the two halves of a release.
#
# Every restic operation the binary performs is exercised against a real
# repository -- backup, cat config, snapshots, restore, unlock, stats -- plus
# `check`, which the binary never calls and which is the only thing that
# catches a pack file that is present, correctly named and wrong.
#
# --rotation adds a machine that is moved to a second bucket while it is
# running: the state poll, the offer, the request, the cutover from the status
# page, the seeding run that CREATES a repository, the release of the old
# bucket, the card, and -- the one worth the whole file -- a run against a URL
# with nothing at it, which must fail rather than create anything. See
# run-rotation.
#
# PARALLELISM
#
# One restic repository per machine, each under its own prefix, so the
# machines share a bucket and nothing else. restic locks per repository, so
# separate prefixes are separate repositories and there is nothing to
# contend over. A shared prefix would serialise them and, worse, would make one
# machine's lock look like another machine's crash.
#
# EXIT CODES
#
#   0  every machine backed up, restored and verified
#   1  a machine ran and the program misbehaved -- do not publish
#   2  no machine could reach the bucket -- nothing was learned either way
#
# The release workflow blocks on 1 and warns on 2. A restore that comes back
# wrong is about the build; a bucket nobody could reach is about Wasabi, and
# failing a release over somebody else's outage turns a safety measure into the
# thing that stops work.
#
# COST
#
# Each machine writes roughly 5 MB. Wasabi bills a minimum storage duration --
# deleting a repository does not stop it being billed for that period -- but
# also a 1 TB monthly minimum, and this is thousands of runs away from that.
# The reaper below is for keeping the bucket legible, not cheap.

set -uo pipefail

cd "$(dirname "$0")/../.."

IMAGE=sion-backup-e2e
SHAPES=3
CORPUS_MB=${CORPUS_MB:-4}
MEASURE_FULL_READ=${MEASURE_FULL_READ:-0}
KEEP=0
REAP_ONLY=0
ROTATION=0
ROTATION_ONLY=0
REAP_DAYS=${REAP_DAYS:-7}

while [ $# -gt 0 ]; do
  case "$1" in
    --shapes)    SHAPES="$2"; shift 2 ;;
    --corpus-mb) CORPUS_MB="$2"; shift 2 ;;
    --full-read) MEASURE_FULL_READ=1; shift ;;
    --keep)      KEEP=1; shift ;;
    --reap-only) REAP_ONLY=1; shift ;;
    --rotation)  ROTATION=1; shift ;;
    --rotation-only) ROTATION=1; ROTATION_ONLY=1; SHAPES=0; shift ;;
    -h|--help)   sed -n '2,40p' "$0" | sed 's/^#\{0,1\} \{0,1\}//'; exit 0 ;;
    *)           echo "backup-e2e: unknown option $1" >&2; exit 2 ;;
  esac
done

# ---------------------------------------------------------------------------
# Credentials. Same file the rest of the release path uses.
# ---------------------------------------------------------------------------

CREDENTIALS=${SION_DEPLOY_ENV:-$HOME/.config/sion-backup/sion-backup-deploy.env}

if [ -z "${WASABI_ACCESS_KEY_ID:-}" ] && [ -f "$CREDENTIALS" ]; then
  # shellcheck source=/dev/null
  . "$CREDENTIALS"
fi

for required in WASABI_ACCESS_KEY_ID WASABI_SECRET_ACCESS_KEY WASABI_BUCKET WASABI_REGION; do
  if [ -z "$(eval "printf '%s' \"\${${required}:-}\"")" ]; then
    echo "backup-e2e: ${required} is not set." >&2
    echo "            Put it in ${CREDENTIALS}, or see 'make deploy-ready'." >&2

    exit 1
  fi
done

if [ "$WASABI_REGION" = us-east-1 ]; then
  ENDPOINT="s3.wasabisys.com"
else
  ENDPOINT="s3.${WASABI_REGION}.wasabisys.com"
fi

BASE="s3:https://${ENDPOINT}/${WASABI_BUCKET}"

# RUN_ID separates this invocation from every other one, so two people running
# this at the same time cannot land in the same repository.
RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
PREFIX_ROOT="gate/$(date -u +%Y-%m-%d)/${RUN_ID}"

say() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }

# ---------------------------------------------------------------------------
# Reaping old repositories.
#
# Wasabi will not delete a prefix, only objects, so this lists and deletes.
# Bounded by age so that a run in progress elsewhere is never touched -- the
# same reasoning as the Vultr reaper, and for the same reason: a filter whose
# failure mode is "delete somebody's data" does not get to be careless.
# ---------------------------------------------------------------------------

sig="aws:amz:${WASABI_REGION}:s3"
auth="${WASABI_ACCESS_KEY_ID}:${WASABI_SECRET_ACCESS_KEY}"

reap() {
  local cutoff
  cutoff=$(date -u -d "${REAP_DAYS} days ago" +%Y-%m-%d 2>/dev/null) || return 0

  say "Reaping test repositories older than ${cutoff}"

  local listing keys removed=0
  listing=$(curl -fsS --aws-sigv4 "$sig" --user "$auth" \
    "https://${ENDPOINT}/${WASABI_BUCKET}?list-type=2&prefix=gate/&max-keys=1000" 2>/dev/null) || {
      echo "    could not list the bucket; nothing reaped" >&2

      return 0
    }

  # Every key under gate/<date>/ whose date is older than the cutoff. Parsed
  # from the key rather than from the object's timestamp, because the date in
  # the path is what this harness controls and a re-uploaded object would
  # otherwise look young.
  keys=$(printf '%s' "$listing" |
    grep -oE '<Key>[^<]+</Key>' | sed 's/<[^>]*>//g' |
    awk -F/ -v cutoff="$cutoff" '$1 == "gate" && $2 < cutoff')

  for key in $keys; do
    curl -fsS -o /dev/null -X DELETE --aws-sigv4 "$sig" --user "$auth" \
      "https://${ENDPOINT}/${WASABI_BUCKET}/${key}" 2>/dev/null && removed=$((removed + 1))
  done

  echo "    removed ${removed} object(s)"
}

if [ "$REAP_ONLY" -eq 1 ]; then
  reap

  exit 0
fi

# ---------------------------------------------------------------------------
# Build.
# ---------------------------------------------------------------------------

WORK="$(mktemp -d)"

cleanup() {
  for i in $(seq 1 "$SHAPES"); do
    docker rm -f "${IMAGE}-${i}" >/dev/null 2>&1 || true
  done

  docker rm -f "${IMAGE}-rotation" >/dev/null 2>&1 || true

  if [ "$KEEP" -eq 1 ]; then
    printf '\n\033[1m==> kept: %s/%s/*\033[0m\n' "$BASE" "$PREFIX_ROOT"
    printf '    repository passwords are in %s/*.password\n' "$WORK"
  else
    rm -rf "$WORK"
  fi
}

trap cleanup EXIT

say "Building"

mkdir -p "$WORK/ctx"

CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath \
  -ldflags "-s -w -X main.version=$(git describe --tags --always 2>/dev/null || echo dev)" \
  -o "$WORK/ctx/sion-backup" ./cmd/sion-backup

CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags '-s -w' \
  -o "$WORK/ctx/eumaeusstub" ./scripts/backup-e2e/eumaeusstub

cp scripts/backup-e2e/run-machine scripts/backup-e2e/run-rotation "$WORK/ctx/"

cat > "$WORK/ctx/Dockerfile" <<'DOCKER'
# A machine that can reach a real bucket.
#
# jq for the assertions, curl for the reachability probe, ca-certificates for
# Wasabi's TLS and for restic's own download from GitHub. No restic here: the
# binary installs its own pinned build, and that download is part of what is
# being tested.
#
# curl is not optional. The probe decides whether a failure blocks a release or
# only warns about one, so a missing curl would silently turn every run into a
# warning -- a gate that never gates.
FROM debian:stable-slim

RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends ca-certificates curl jq procps iproute2 \
 && rm -rf /var/lib/apt/lists/*

COPY sion-backup /usr/local/bin/sion-backup
COPY eumaeusstub /harness/eumaeusstub
COPY run-machine /harness/run-machine
COPY run-rotation /harness/run-rotation
RUN chmod 0755 /usr/local/bin/sion-backup /harness/eumaeusstub \
                /harness/run-machine /harness/run-rotation

ENTRYPOINT ["/harness/run-machine"]
DOCKER

docker build -q -t "$IMAGE" "$WORK/ctx" >/dev/null

# ---------------------------------------------------------------------------
# Run, in parallel, one repository each.
# ---------------------------------------------------------------------------

if [ "$ROTATION_ONLY" -eq 1 ]; then
  say "Rotating one machine to a fresh bucket in ${WASABI_BUCKET}"
else
  say "Backing up ${SHAPES} machine(s) to ${WASABI_BUCKET}"
  echo "    ${BASE}/${PREFIX_ROOT}/<shape>"
fi

pids=()
names=()

# The rotation machine gets three prefixes of its own: the bucket it starts on,
# the bucket it is moved to, and one that is never created, for the refusal at
# the end. Three rather than two because "a URL with nothing at it" has to be a
# URL nothing has ever been at.
if [ "$ROTATION" -eq 1 ]; then
  echo "    ${BASE}/${PREFIX_ROOT}/rotation-{old,new}"

  docker run --rm --name "${IMAGE}-rotation" \
    --entrypoint /harness/run-rotation \
    -e "REPO_URL=${BASE}/${PREFIX_ROOT}/rotation-old" \
    -e "NEXT_URL=${BASE}/${PREFIX_ROOT}/rotation-new" \
    -e "SPARE_URL=${BASE}/${PREFIX_ROOT}/rotation-never-made" \
    -e "KEY_ID=${WASABI_ACCESS_KEY_ID}" \
    -e "SECRET=${WASABI_SECRET_ACCESS_KEY}" \
    -e "NODE_ID=gate-${RUN_ID}-rotation" \
    -e "AWS_REGION=${WASABI_REGION}" \
    "$IMAGE" >"$WORK/rotation.log" 2>&1 &

  pids+=("$!")
  names+=("rotation")

  echo "    started rotation"
fi

for i in $(seq 1 "$SHAPES"); do
  shape="machine-${i}"
  repo="${BASE}/${PREFIX_ROOT}/${shape}"

  # Each in its own container, its own repository, its own log. Nothing is
  # shared but the bucket and the credentials.
  docker run --rm --name "${IMAGE}-${i}" \
    -e "REPO_URL=${repo}" \
    -e "KEY_ID=${WASABI_ACCESS_KEY_ID}" \
    -e "SECRET=${WASABI_SECRET_ACCESS_KEY}" \
    -e "NODE_ID=gate-${RUN_ID}-${i}" \
    -e "SHAPE=${shape}" \
    -e "AWS_REGION=${WASABI_REGION}" \
    -e "CORPUS_MB=${CORPUS_MB}" \
    -e "MEASURE_FULL_READ=${MEASURE_FULL_READ}" \
    "$IMAGE" >"$WORK/${shape}.log" 2>&1 &

  pids+=("$!")
  names+=("${shape}")

  echo "    started ${shape}"
done

# Two kinds of not-passing, counted apart. See run-machine on why the
# difference decides whether a release ships.
failed=0
unreachable=0

for pid in "${pids[@]}"; do
  status=0
  wait "$pid" || status=$?

  case "$status" in
    0) ;;
    2) unreachable=$((unreachable + 1)) ;;
    *) failed=$((failed + 1)) ;;
  esac
done

# Printed after the wait rather than streamed, because several machines writing
# to one terminal at once is unreadable and the whole point is to be read.
for name in "${names[@]}"; do
  printf '\n\033[1m==================== %s ====================\033[0m\n' "$name"
  cat "$WORK/${name}.log"
done

# ---------------------------------------------------------------------------

say "Result"

[ "$KEEP" -eq 0 ] && reap

total=${#names[@]}

if [ "$failed" -gt 0 ]; then
  printf '\n  \033[31m%d of %d machine(s) failed a check\033[0m\n' "$failed" "$total"
  printf '  This is about the build. Do not publish it.\n\n'

  exit 1
fi

if [ "$unreachable" -gt 0 ]; then
  printf '\n  \033[33m%d of %d machine(s) could not reach the bucket\033[0m\n' "$unreachable" "$total"
  printf '  Nothing was learned about the build, good or bad.\n\n'

  exit 2
fi

if [ "$ROTATION_ONLY" -eq 1 ]; then
  printf '\n  \033[32mone machine was moved to a fresh bucket and kept working\033[0m\n\n'
else
  printf '\n  \033[32mall %d machine(s) backed up, restored and verified\033[0m\n\n' "$total"
fi
