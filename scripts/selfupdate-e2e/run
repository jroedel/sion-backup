#!/usr/bin/env bash
#
# run — drive the self-update harness.
#
# Builds two real sion-backup binaries from this tree, stands up something that
# answers as GitHub, and puts one machine at a time in front of it.
#
#     scripts/selfupdate-e2e/run                 # every case
#     scripts/selfupdate-e2e/run happy bricked   # only these
#     scripts/selfupdate-e2e/run --list          # what there is
#
# WHAT THIS PROVES, AND WHAT IT DOES NOT
#
# It proves that the release binary, unmodified, doing real DNS and real TLS
# against a release it cannot tell from GitHub's, refuses every broken release
# and leaves the machine on the version it started with. That is the part unit
# tests mock away, and it is most of the risk.
#
# It does not prove anything about systemd's user manager and lingering, a
# Windows scheduled task, launchd, Full Disk Access, or a machine that has been
# running the previous release for a month. Those need a real machine; see
# docs/selfupdate-testing.md and scripts/selfupdate-gate.

set -euo pipefail

cd "$(dirname "$0")/../.."

IMAGE=sion-selfupdate-e2e
NETWORK=sion-selfupdate-e2e
CURRENT_VERSION=v9.9.8
NEXT_VERSION=v9.9.9

# ---------------------------------------------------------------------------
# The matrix.
#
# Hand-picked, because the fleet is four or five clients rather than a
# distribution: every line is a way a release or a machine has actually been
# wrong somewhere, and the ones that are guesses say so. Fields:
#
#   name | fault | offered-binary | expectation | environment...
#
# offered-binary is what the release serves as sion-backup-linux-amd64:
#   next    a good build stamped $NEXT_VERSION
#   stale   a good build stamped $CURRENT_VERSION, offered as $NEXT_VERSION
#   broken  a build that answers `version` and dies on `daemon`
# ---------------------------------------------------------------------------

CASES=(
  # -- The release is wrong. Every one of these must leave the machine alone.
  "happy|none|next|updated|"
  "wrong-hash|wrong-hash|next|refused|"
  "truncated|truncated|next|refused|"
  "corrupt-mid|corrupt-mid|next|refused|"
  "no-sums|no-sums|next|refused|"
  "no-asset|no-asset|next|refused|"
  "prerelease|prerelease|next|refused|"
  "draft|draft|next|refused|"
  "rate-limited|rate-limited|next|refused|"
  "hangup|hangup|next|refused|"
  "version-lie|none|stale|refused|"

  # -- Nothing to do. Not errors, and a machine that treats them as errors
  #    reports hourly and buries the reports that matter.
  "already-current|none|stale|nothing-to-do|NEXT_VERSION=$CURRENT_VERSION"
  "downgrade|none|next|nothing-to-do|CURRENT_VERSION=v9.9.9 NEXT_VERSION=v9.9.9 OFFER_TAG=v9.9.7"
  "dev-build|none|next|nothing-to-do|CURRENT_VERSION=dev"

  # -- The machine is the variable. These are the fleet's real install shapes.
  "user-local-bin|none|next|updated|INSTALL_DIR=/home/sion/.local/bin INSTALL_OWNER=sion RUN_AS=sion"
  "program-files|none|next|not-writable|INSTALL_DIR=/opt/sion/bin INSTALL_OWNER=root DIR_MODE=0755 RUN_AS=sion"
  "elevated-task|none|next|updated|INSTALL_DIR=/opt/sion/bin INSTALL_OWNER=root RUN_AS=root"
  "readonly-mount|none|next|not-writable|READONLY=1 INSTALL_DIR=/opt/ro/bin RUN_AS=sion"

  # -- The one that used to be a demonstration of a gap. A build that passes
  #    the hash and the smoke test and then will not start must end with the
  #    machine back on the version that worked, and refusing that release.
  "rolled-back|none|broken|rolled-back|MAX_STARTS=6"
)

case "${1:-}" in
  --list|-l)
    for c in "${CASES[@]}"; do printf '%s\n' "${c%%|*}"; done
    exit 0
    ;;
  -h|--help)
    sed -n '2,28p' "$0" | sed 's/^#\{0,1\} \{0,1\}//'
    exit 0
    ;;
esac

WANTED=("$@")

wanted() {
  [ ${#WANTED[@]} -eq 0 ] && return 0

  local w
  for w in "${WANTED[@]}"; do [ "$w" = "$1" ] && return 0; done

  return 1
}

# ---------------------------------------------------------------------------
# Build.
# ---------------------------------------------------------------------------

WORK="$(mktemp -d)"

# teardown removes everything this harness created, in an order that works.
#
# A network cannot be removed while a container is attached, and an interrupted
# run leaves one attached — so the containers go first, by name, and then
# anything else still holding the network. Without that last step one killed
# run wedges every later one with "network already exists".
teardown() {
  docker rm -f "$NETWORK-server" "$NETWORK-case" >/dev/null 2>&1 || true

  local held
  held=$(docker ps -aq --filter "network=$NETWORK" 2>/dev/null || true)

  if [ -n "$held" ]; then
    # shellcheck disable=SC2086  # a list of ids, deliberately split
    docker rm -f $held >/dev/null 2>&1 || true
  fi

  docker network rm "$NETWORK" >/dev/null 2>&1 || true
}

cleanup() {
  teardown
  # The read-only case's bind mount is populated as this user, so nothing here
  # needs root to remove.
  rm -rf "$WORK"
}

trap cleanup EXIT

echo "==> building"

mkdir -p "$WORK/bin" "$WORK/ctx" "$WORK/in" "$WORK/assets"

# Static, so the binary that runs in the container is the one a release ships
# and not one that found a different libc.
build() {
  CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags "-s -w -X main.version=$2" -o "$1" "$3"
}

build "$WORK/bin/next"    "$NEXT_VERSION"    ./cmd/sion-backup
build "$WORK/bin/stale"   "$CURRENT_VERSION" ./cmd/sion-backup
build "$WORK/bin/broken"  "$NEXT_VERSION"    ./scripts/selfupdate-e2e/brokenbuild
build "$WORK/ctx/releaseserver" ""           ./scripts/selfupdate-e2e/releaseserver

cp scripts/selfupdate-e2e/{Dockerfile,run-case,supervise} "$WORK/ctx/"

# The image's COPY of the release server is appended rather than kept in the
# Dockerfile, because the Dockerfile is also readable on its own and a COPY of
# a file the repository does not contain reads like a mistake.
cat >>"$WORK/ctx/Dockerfile" <<'DOCKER'

# Built by ../run into the context: it serves the fake release, from inside the
# network, under the hostnames the binary under test resolves.
COPY releaseserver /harness/releaseserver
DOCKER

docker build -q -t "$IMAGE" "$WORK/ctx" >/dev/null

teardown
docker network create "$NETWORK" >/dev/null

# ---------------------------------------------------------------------------
# Run.
# ---------------------------------------------------------------------------

passed=0
failed=0
skipped=0
failures=()

for spec in "${CASES[@]}"; do
  IFS='|' read -r name fault offered expect environment <<<"$spec"

  if ! wanted "$name"; then
    skipped=$((skipped + 1))
    continue
  fi

  # Per-case defaults, overridable by the environment field. Set here rather
  # than exported once, so one case cannot leak into the next.
  CASE_CURRENT="$CURRENT_VERSION"
  CASE_NEXT="$NEXT_VERSION"
  OFFER_TAG=""
  READONLY=""
  INSTALL_DIR=""
  INSTALL_OWNER=""
  DIR_MODE=""
  RUN_AS=""
  MAX_STARTS=""

  # shellcheck disable=SC2086  # deliberately word-split: it is a list of assignments
  if [ -n "$environment" ]; then
    for assignment in $environment; do
      case "$assignment" in
        CURRENT_VERSION=*) CASE_CURRENT="${assignment#*=}" ;;
        NEXT_VERSION=*)    CASE_NEXT="${assignment#*=}" ;;
        *)                 declare "${assignment%%=*}=${assignment#*=}" ;;
      esac
    done
  fi

  tag="${OFFER_TAG:-$CASE_NEXT}"

  printf '\n==> %s  (fault: %s, offers: %s %s, expects: %s)\n' \
    "$name" "$fault" "$offered" "$tag" "$expect"

  # What the release serves, and what the machine starts with. Rebuilt per
  # case: the stale/dev cases change which is which.
  rm -f "$WORK/assets"/* "$WORK/in/current"
  cp "$WORK/bin/$offered" "$WORK/assets/sion-backup-linux-amd64"

  case "$CASE_CURRENT" in
    "$CURRENT_VERSION") cp "$WORK/bin/stale" "$WORK/in/current" ;;
    "$NEXT_VERSION")    cp "$WORK/bin/next"  "$WORK/in/current" ;;
    *)                  build "$WORK/in/current" "$CASE_CURRENT" ./cmd/sion-backup ;;
  esac

  # The release server, inside the network, answering to GitHub's names. Docker's
  # embedded DNS resolves a network alias before it forwards upstream, so the
  # binary under test looks up api.github.com and gets this. No /etc/hosts, no
  # host port, and nothing on the host listening on 443.
  rm -f "$WORK/in/ca.pem" "$WORK/in/ready"

  docker rm -f "$NETWORK-server" >/dev/null 2>&1 || true

  docker run -d --name "$NETWORK-server" \
    --network "$NETWORK" \
    --network-alias api.github.com \
    --network-alias objects.githubusercontent.com \
    --network-alias github.com \
    -v "$WORK/assets:/assets:ro" \
    -v "$WORK/in:/out" \
    --entrypoint /harness/releaseserver \
    "$IMAGE" \
      -addr :443 \
      -assets /assets \
      -tag "$tag" \
      -fault "$fault" \
      -ca-out /out/ca.pem \
      -ready /out/ready >/dev/null

  for _ in $(seq 1 100); do
    [ -f "$WORK/in/ready" ] && break
    sleep 0.1
  done

  if [ ! -f "$WORK/in/ready" ]; then
    echo "      FAIL the release server never came up"
    docker logs "$NETWORK-server" 2>&1 | sed 's/^/      | /'
    failed=$((failed + 1))
    failures+=("$name")
    continue
  fi

  mounts=(-v "$WORK/in:/in:ro")

  if [ -n "$READONLY" ]; then
    # A real read-only bind rather than a permission trick: the code comments
    # name it as its own cause, and it fails at a different syscall.
    mkdir -p "$WORK/romount"
    cp "$WORK/in/current" "$WORK/romount/sion-backup"
    chmod 0755 "$WORK/romount/sion-backup"
    mounts+=(--mount "type=bind,source=$WORK/romount,target=${INSTALL_DIR},readonly")
    PREINSTALLED=1
  fi

  if docker run --rm --name "$NETWORK-case" --network "$NETWORK" "${mounts[@]}" \
    -e "CURRENT_VERSION=$CASE_CURRENT" \
    -e "NEXT_VERSION=$CASE_NEXT" \
    -e "EXPECT=$expect" \
    ${INSTALL_DIR:+-e "INSTALL_DIR=$INSTALL_DIR"} \
    ${INSTALL_OWNER:+-e "INSTALL_OWNER=$INSTALL_OWNER"} \
    ${DIR_MODE:+-e "DIR_MODE=$DIR_MODE"} \
    ${RUN_AS:+-e "RUN_AS=$RUN_AS"} \
    ${MAX_STARTS:+-e "MAX_STARTS=$MAX_STARTS"} \
    ${PREINSTALLED:+-e "PREINSTALLED=$PREINSTALLED"} \
    "$IMAGE"
  then
    passed=$((passed + 1))
  else
    failed=$((failed + 1))
    failures+=("$name")
  fi

  unset PREINSTALLED

  docker rm -f "$NETWORK-server" >/dev/null 2>&1 || true
done

printf '\n==> %d passed, %d failed' "$passed" "$failed"
[ "$skipped" -gt 0 ] && printf ', %d not run' "$skipped"
printf '\n'

if [ "$failed" -gt 0 ]; then
  printf '    %s\n' "${failures[@]}"
  exit 1
fi
