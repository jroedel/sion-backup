# A systemd USER unit, not a system one.
#
#   mkdir -p ~/.config/systemd/user
#   cp sion-backup.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now sion-backup
#   loginctl enable-linger "$USER"     # keep it running when nobody is logged in
#
# User rather than system, for now, and the reason is no longer the one it used
# to be. This unit predates the change that stopped caching credentials: there
# was a login keyring to unlock, and a system service running as root had no
# session to unlock it from. Nothing is cached any more — the S3 keys and the
# repository password are fetched from Eumaeus at the start of every run and
# discarded at the end — so that argument is gone.
#
# What is left is smaller: this backs up one person's files, and running as
# that person is the simplest way to be able to read them.
#
# It is not the end state. A dedicated system account is better, and is what
# the legacy scripts this replaces actually did:
#
#   useradd --system --shell /sbin/nologin sion-backup
#   setcap cap_dac_read_search=+ep /usr/local/bin/restic
#
# That capability lets an unprivileged account read every file on the machine
# without being root, and it means the machine token — the one secret on this
# disk — is owned by an account the desktop user cannot read. Against
# ransomware running as the desktop user, that is the difference that matters.
# Moving needs machine-scope paths first (foundation/paths is per-user today)
# and an answer to who may change the excludes on the status page.
#
# The cost of the user unit is `loginctl enable-linger`: without it the unit
# stops when the last session ends, and a machine that is switched on but not
# logged into takes no backups. With it, the user manager starts at boot and
# the unit with it.

[Unit]
Description=sion-backup — keeps this computer backed up
Documentation=https://github.com/jroedel/sion-backup
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/sion-backup daemon

# Restart, always, with a delay. The failure this program exists to prevent is
# a backup agent that died in March and was noticed in September.
Restart=always
RestartSec=30s

# Journal, and the program's own log file beside its data. Both, because the
# journal is where an administrator looks and the file is what a user can be
# asked to send.
StandardOutput=journal
StandardError=journal

# It reads everything the user can read — that is the job — so most sandboxing
# would break it. These four cost nothing and close the obvious holes.
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

# Nice, not idle. A backup that never finishes because the machine is busy is
# not politeness, it is a missing backup; but it should not make the machine
# feel slow either.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=default.target
